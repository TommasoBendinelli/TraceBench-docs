\newcommand{\manualDocMaybeEnableLineNumbers}{%
  \ifmanualDocLineNumbers
    \renewcommand{\linenumberfont}{\normalfont\tiny\sffamily\color{gray}}%
    \setlength{\linenumbersep}{10pt}%
    \modulolinenumbers[1]%
    \linenumbers
  \fi
}
\newcommand{\manualDocDocCodeNumberStyle}{%
  {\linenumberfont\arabic{FancyVerbLine}}%
}
\definecolor{manualDocCodeBg}{RGB}{248,248,248}
\definecolor{manualDocCodeBorder}{RGB}{210,210,210}
\makeatletter
\newcommand{\manualDocBeginNumberedDocCode}{%
  \nolinenumbers
  \global\c@FancyVerbLine=\numexpr\value{linenumber}-1\relax
}
\newcommand{\manualDocEndNumberedDocCode}{%
  \global\c@runninglinenumber=\numexpr\value{FancyVerbLine}+1\relax
  \global\c@linenumber=\c@runninglinenumber
  \linenumbers
}
\makeatother
\newcommand{\docTitle}[2][]{%
  \renewcommand{\manualDocName}{#2}%
  \if\relax\detokenize{#1}\relax
  \else
    \renewcommand{\manualDocName}{#1}%
  \fi
  \fancyhf{}%
  \fancyhead[L]{\footnotesize tsENV | \manualDocName{} | \manualDocSourceName}%
  \fancyhead[R]{\today}%
  \fancyfoot[C]{\thepage}%
  \pagestyle{fancy}%
  \manualDocMaybeEnableLineNumbers
  \ifmanualDocSuppressCenteredTitle
  \else
    {\centering\LARGE\bfseries #2\par}%
    \vspace{0.5em}%
  \fi
  \global\manualDocSuppressCenteredTitlefalse
}

\ifmanualDocLineNumbers
  \renewcommand{\theFancyVerbLine}{\manualDocDocCodeNumberStyle}
  \DefineVerbatimEnvironment{DocCode}{Verbatim}{
    fontsize=\small,
    breaklines=true,
    breakanywhere=true,
    breaksymbolleft={},
    breaksymbolright={},
    frame=single,
    framerule=0.35pt,
    framesep=3pt,
    rulecolor=\color{manualDocCodeBorder},
    bgcolor=manualDocCodeBg,
    numbers=left,
    stepnumber=1,
    numberblanklines=true,
    numbersep=10pt,
    firstnumber=last
  }
  \BeforeBeginEnvironment{DocCode}{\manualDocBeginNumberedDocCode}
  \AfterEndEnvironment{DocCode}{\manualDocEndNumberedDocCode}
\else
  \DefineVerbatimEnvironment{DocCode}{Verbatim}{
    fontsize=\small,
    breaklines=true,
    breakanywhere=true,
    breaksymbolleft={},
    breaksymbolright={},
    frame=single,
    framerule=0.35pt,
    framesep=3pt,
    rulecolor=\color{manualDocCodeBorder},
    bgcolor=manualDocCodeBg
  }
\fi

