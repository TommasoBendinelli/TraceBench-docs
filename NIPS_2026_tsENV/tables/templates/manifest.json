{
  "schema_version": "1",
  "generator": "generate_paper_table.py",
  "template_root": "docs/NIPS_2026_tsENV/tables/templates",
  "notes": [
    "This manifest documents the current table-generation contract. It is not read by the generator.",
    "The path segment enviroment_specific is intentionally spelled to match the existing generated directory."
  ],
  "data_sources": {
    "consolidated_results": {
      "description": "Run summaries and sample-level entries collected by consolidate_results.py and consumed by generate_paper_table.py.",
      "used_by": [
        "main_aggregate_tables",
        "ablation_aggregate_tables",
        "per_environment_accuracy_tables",
        "per_row_slug_calibration_appendix_tables"
      ]
    },
    "experiment_plan_rows": {
      "description": "Experiment metadata rows used to select experiments, row slugs, simulator environments, agents, and task conditions.",
      "used_by": [
        "main_aggregate_tables",
        "ablation_aggregate_tables",
        "per_environment_accuracy_tables",
        "per_row_slug_calibration_appendix_tables"
      ]
    },
    "question_sample_manifests": {
      "path_pattern": "tsENV_questions/<Environment>/sample_manifest.json",
      "description": "Question baseline metadata used for per-environment question-baseline appendix tables.",
      "used_by": [
        "question_baseline_tables"
      ]
    }
  },
  "metric_prefixes": {
    "acc": {
      "generator_metric": "accuracy",
      "value_scale": 1.0,
      "description": "Top-1 accuracy."
    },
    "acc_normalised": {
      "generator_metric": "accuracy_normalised",
      "value_scale": 1.0,
      "description": "Chance-normalized top-1 accuracy. Generated but not currently included in the paper or appendix."
    },
    "shortlist_score": {
      "generator_metric": "shortlist_score",
      "value_scale": 1.0,
      "description": "Shortlist score as defined in the paper."
    },
    "shortlist_number_of_answers": {
      "generator_metric": "shortlist_number_of_answers",
      "value_scale": 1.0,
      "description": "Number of answers in the submitted shortlist."
    },
    "cost": {
      "generator_metric": "cost",
      "value_scale": 1.0,
      "description": "Estimated run cost."
    },
    "cum": {
      "generator_metric": "cumulative_tokens",
      "value_scale": 0.000001,
      "description": "Cumulative token usage reported in millions."
    },
    "num_steps": {
      "generator_metric": "num_steps",
      "value_scale": 1.0,
      "description": "Number of agent steps."
    },
    "python_calls": {
      "generator_metric": "python_calls",
      "value_scale": 1.0,
      "description": "Number of Python calls."
    },
    "plots_generated": {
      "generator_metric": "plots_generated",
      "value_scale": 1.0,
      "description": "Number of plot artifacts generated."
    }
  },
  "table_groups": {
    "main_aggregate_tables": {
      "output_pattern": "docs/NIPS_2026_tsENV/tables/main_tables/<prefix>_main_experiment_table.tex",
      "source_experiments": [
        "baseline",
        "code_baseline",
        "baseline_noise_high",
        "code_baseline_noise_high"
      ],
      "templates_by_prefix": {
        "acc": "acc_main.tex",
        "acc_normalised": "acc_main.tex",
        "shortlist_score": "acc_main.tex",
        "shortlist_number_of_answers": "acc_main.tex",
        "cost": "cost_main.tex",
        "cum": "cost_main.tex",
        "num_steps": "cost_main.tex",
        "python_calls": "cost_main.tex",
        "plots_generated": "cost_main.tex"
      },
      "main_paper_includes": [
        "tables/main_tables/acc_main_experiment_table",
        "tables/main_tables/cum_main_experiment_table"
      ],
      "appendix_includes": [
        "tables/main_tables/acc_main_experiment_table",
        "tables/main_tables/shortlist_score_main_experiment_table",
        "tables/main_tables/shortlist_number_of_answers_main_experiment_table",
        "tables/main_tables/cost_main_experiment_table",
        "tables/main_tables/cum_main_experiment_table",
        "tables/main_tables/num_steps_main_experiment_table",
        "tables/main_tables/python_calls_main_experiment_table",
        "tables/main_tables/plots_generated_main_experiment_table"
      ],
      "generated_not_included": [
        "tables/main_tables/acc_normalised_main_experiment_table"
      ]
    },
    "ablation_aggregate_tables": {
      "output_pattern": "docs/NIPS_2026_tsENV/tables/main_tables/<prefix>_ablation_training_examples.tex",
      "source_experiments": [
        "direct_context_shot_3",
        "code_context_shot_3",
        "no_context_shot",
        "code_no_context_shot"
      ],
      "templates_by_prefix": {
        "acc": "acc_ablation.tex",
        "acc_normalised": "acc_ablation.tex",
        "shortlist_score": "acc_ablation.tex",
        "shortlist_number_of_answers": "acc_ablation.tex",
        "cost": "ablation_main.tex",
        "cum": "ablation_main.tex",
        "num_steps": "ablation_main.tex",
        "python_calls": "ablation_main.tex",
        "plots_generated": "ablation_main.tex"
      },
      "main_paper_includes": [
        "tables/main_tables/acc_ablation_training_examples",
        "tables/main_tables/cum_ablation_training_examples"
      ],
      "appendix_includes": [
        "tables/main_tables/acc_ablation_training_examples",
        "tables/main_tables/shortlist_score_ablation_training_examples",
        "tables/main_tables/shortlist_number_of_answers_ablation_training_examples",
        "tables/main_tables/cost_ablation_training_examples",
        "tables/main_tables/cum_ablation_training_examples",
        "tables/main_tables/num_steps_ablation_training_examples",
        "tables/main_tables/python_calls_ablation_training_examples",
        "tables/main_tables/plots_generated_ablation_training_examples"
      ],
      "generated_not_included": [
        "tables/main_tables/acc_normalised_ablation_training_examples"
      ]
    },
    "per_environment_accuracy_tables": {
      "output_patterns": [
        "docs/NIPS_2026_tsENV/tables/main_tables/enviroment_specific/<Environment>_acc_main_experiment_table.tex",
        "docs/NIPS_2026_tsENV/tables/main_tables/enviroment_specific/<Environment>_acc_ablation_training_examples.tex"
      ],
      "source_experiments": {
        "main": [
          "baseline",
          "code_baseline",
          "baseline_noise_high",
          "code_baseline_noise_high"
        ],
        "ablation": [
          "direct_context_shot_3",
          "code_context_shot_3",
          "no_context_shot",
          "code_no_context_shot"
        ]
      },
      "templates_by_output": {
        "<Environment>_acc_main_experiment_table.tex": "acc_main.tex",
        "<Environment>_acc_ablation_training_examples.tex": "acc_ablation.tex"
      },
      "appendix_includes": [
        "tables/main_tables/enviroment_specific/BallDrop_acc_main_experiment_table",
        "tables/main_tables/enviroment_specific/BallDrop_acc_ablation_training_examples",
        "tables/main_tables/enviroment_specific/InclinedPlane_acc_main_experiment_table",
        "tables/main_tables/enviroment_specific/InclinedPlane_acc_ablation_training_examples",
        "tables/main_tables/enviroment_specific/DampedMassBetweenWalls_acc_main_experiment_table",
        "tables/main_tables/enviroment_specific/DampedMassBetweenWalls_acc_ablation_training_examples"
      ]
    },
    "per_row_slug_calibration_appendix_tables": {
      "output_pattern": "docs/NIPS_2026_tsENV/tables/main_tables/appendix/calibration/<row_slug>.tex",
      "template": "per_row_slug/1_row_slugs.tex",
      "source": "One experiment-plan row and matching consolidated run summaries for the same row_slug.",
      "appendix_index": "docs/NIPS_2026_tsENV/appendix_calibration_tables.tex",
      "appendix_includes": [
        "tables/main_tables/appendix/calibration/gentle_01234-cloud",
        "tables/main_tables/appendix/calibration/gentle_01234-flame",
        "tables/main_tables/appendix/calibration/gentle_01234-pine",
        "tables/main_tables/appendix/calibration/gentle_01234-orbit",
        "tables/main_tables/appendix/calibration/frost_01234-anchor",
        "tables/main_tables/appendix/calibration/frost_01234-pine",
        "tables/main_tables/appendix/calibration/frost_01234-orbit",
        "tables/main_tables/appendix/calibration/gentle_01234-harbor",
        "tables/main_tables/appendix/calibration/gentle_01234-tide"
      ]
    },
    "question_baseline_tables": {
      "output_pattern": "docs/NIPS_2026_tsENV/tables/main_tables/enviroment_specific/<Environment>_question_baselines.tex",
      "template": null,
      "render_function": "_render_question_baseline_table",
      "source": "tsENV_questions/<Environment>/sample_manifest.json",
      "appendix_includes": [
        "tables/main_tables/enviroment_specific/BallDrop_question_baselines",
        "tables/main_tables/enviroment_specific/InclinedPlane_question_baselines",
        "tables/main_tables/enviroment_specific/DampedMassBetweenWalls_question_baselines"
      ]
    }
  },
  "templates": {
    "acc_main.tex": {
      "status": "active",
      "used_by": [
        "main_aggregate_tables",
        "per_environment_accuracy_tables"
      ]
    },
    "acc_ablation.tex": {
      "status": "active",
      "used_by": [
        "ablation_aggregate_tables",
        "per_environment_accuracy_tables"
      ]
    },
    "cost_main.tex": {
      "status": "active",
      "used_by": [
        "main_aggregate_tables"
      ]
    },
    "ablation_main.tex": {
      "status": "active",
      "used_by": [
        "ablation_aggregate_tables"
      ]
    },
    "per_row_slug/1_row_slugs.tex": {
      "status": "active",
      "used_by": [
        "per_row_slug_calibration_appendix_tables"
      ]
    },
    "cost_ablation.tex": {
      "status": "fallback_only",
      "used_by": [],
      "fallback_for": "ablation_main.tex",
      "note": "generate_paper_table.py only tries this file when loading ablation_main.tex and ablation_main.tex is missing."
    },
    "seperated_env.tex": {
      "status": "unused",
      "used_by": []
    },
    "per_row_slug/2_row_slugs.tex": {
      "status": "unused",
      "used_by": []
    },
    "per_row_slug/calibration.tex": {
      "status": "unused",
      "used_by": []
    },
    "per_row_slug/default.tex": {
      "status": "unused",
      "used_by": []
    }
  }
}
